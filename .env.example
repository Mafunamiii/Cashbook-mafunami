# Copy this file to .env and replace values before starting Compose.
POSTGRES_DB=cashbook
POSTGRES_USER=cashbook
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://cashbook:change-me-to-a-long-random-password@db:5432/cashbook
BACKEND_PORT=8002
FRONTEND_PORT=3004

# Authentication. Keep this code outside source control and distribute it only
# through a trusted channel. Registration is invite-only unless explicitly set
# to "open".
REGISTRATION_MODE=invite_only
INITIAL_INVITE_CODE=replace-with-a-long-random-invite-code
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:3004
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,backend
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Optional monitoring. Create separate Sentry React and FastAPI projects.
# The DSNs identify their projects; do not put a Sentry auth token here.
SENTRY_FRONTEND_DSN=
SENTRY_BACKEND_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
