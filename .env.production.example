# Copy to .env on the production host. Replace every placeholder locally and
# restrict permissions (for example: chmod 600 .env). Never commit that file.
POSTGRES_DB=cashbook
POSTGRES_USER=cashbook
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://cashbook:replace-with-a-long-random-database-password@db:5432/cashbook

# The application itself stays on loopback; the host Nginx instance terminates TLS.
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_ORIGIN=https://cashbook.mafunami.me
TRUSTED_HOSTS=cashbook.mafunami.me
# Because the backend is published only to host loopback, '*' is acceptable for
# a host Nginx proxy. Use a specific proxy source address if it is known.
FORWARDED_ALLOW_IPS=*

REGISTRATION_MODE=invite_only
INITIAL_INVITE_CODE=replace-with-a-long-random-invite-code
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Monitoring. Use the same release (normally the deployed Git SHA) for both
# projects so browser and API events can be correlated.
SENTRY_FRONTEND_DSN=
SENTRY_BACKEND_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Backup configuration. The remote account must have a restricted SSH key and
# write access only to this directory. Do not put the private key in this repo.
BACKUP_DIR=/var/backups/cashbook
BACKUP_SSH_TARGET=cashbook-backup@vps.example.net
BACKUP_REMOTE_PATH=/srv/backups/cashbook
