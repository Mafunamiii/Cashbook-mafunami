# Copy to .env on the production host. Replace every placeholder locally and
# restrict permissions (for example: chmod 600 .env). Never commit that file.
POSTGRES_DB=cashbook
POSTGRES_USER=cashbook
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://cashbook:replace-with-a-long-random-database-password@db:5432/cashbook

# The application itself stays on loopback; the host Nginx instance terminates TLS.
BACKEND_PORT=8002
FRONTEND_PORT=3004
# Bind the frontend only to loopback plus this host's LAN and Tailscale
# interfaces. Update these if the host addresses change.
LAN_BIND_IP=192.168.2.2
TAILSCALE_BIND_IP=100.93.39.106
FRONTEND_ORIGIN=https://cashbook.mafunami.me
TRUSTED_HOSTS=cashbook.mafunami.me,backend,127.0.0.1,localhost,192.168.2.2,100.93.39.106,homeserver.hornbill-paradise.ts.net
# The backend accepts forwarded headers only from the private deployment
# topology. Replace '*' with a narrower Docker-network source when practical.
FORWARDED_ALLOW_IPS=*

REGISTRATION_MODE=invite_only
INITIAL_INVITE_CODE=replace-with-a-long-random-invite-code
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Optional Frankfurter v2 endpoint for active currency choices and historical
# FX snapshots. It requires no API key.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# Monitoring. Use the same release (normally the deployed Git SHA) for both
# projects so browser and API events can be correlated.
SENTRY_FRONTEND_DSN=
SENTRY_BACKEND_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Backup configuration. The remote account must have a restricted SSH key and
# write access only to this directory. Do not put the private key in this repo.
BACKUP_DIR=/var/backups/cashbook
BACKUP_SSH_TARGET=cashbook-backup@vps.example.net
BACKUP_REMOTE_PATH=/srv/backups/cashbook
