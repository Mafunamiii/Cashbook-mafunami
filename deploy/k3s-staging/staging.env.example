# Copy to a local, untracked file named staging.env before running the helper.
# Use a new staging-only database and invite code. Do not reuse local or
# homelab production values. URL-encode special characters in DATABASE_URL.
POSTGRES_DB=namicash_staging
POSTGRES_USER=namicash_staging
POSTGRES_PASSWORD=replace-with-a-new-staging-only-password
DATABASE_URL=postgresql+psycopg://namicash_staging:replace-with-a-new-staging-only-password@postgresql:5432/namicash_staging
INITIAL_INVITE_CODE=replace-with-a-new-staging-only-invite-code-at-least-20-chars
