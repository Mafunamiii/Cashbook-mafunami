# Copy to .env.bluegreen.staging (ignored by Git). Replace the example password.
STAGING_ISOLATED=1
POSTGRES_DB=namicash_stage
POSTGRES_USER=stage
POSTGRES_PASSWORD=stage_replace_with_random_value
DATABASE_URL=postgresql://stage:stage_replace_with_random_value@db:5432/namicash_stage
FRONTEND_ORIGIN=https://stage.namicash.invalid
TRUSTED_HOSTS=stage.namicash.invalid
FORWARDED_ALLOW_IPS=127.0.0.1
REGISTRATION_MODE=open
